## apply GLMM model to explore relationship bewtwen catch and duration (width of run)
rm(list = ls())
###################
## Load Packages ##
###################
library(plyr)
library(lubridate)
library(reshape)
library(data.table)
library(dplyr)
library(ggplot2)
library(lme4)
library(car)
library(lmerTest)
library(performance)
library(lsmeans)
library(multcomp)
library(ggeffects)
library(merTools)
###############
## load data ##
###############
df <- readRDS("C:/Users/midwoodj/Documents/github/Timing-Windows/02_Data/TW_Fishway_Window_Catch_04July2025.rds") 
head(df) 
setwd("~/github/Timing-Windows/03_Output/")
levels(df$fSpecies)[levels(df$fSpecies) == "Bowfin"] <- "Emerald Bowfin"

##############
## Analysis ##
#############
m1.2 <- lmer(Window ~ logCatch + (logCatch | fSpecies) ,data=df, REML=T) ## random slope and intercept by species 
summary(m1.2) # p=0.136 
plot(m1.2)

## plot overall fixed effect - SUPPLEMENTAL FIGURE S3
pred <- ggpredict(m1.2, terms = "logCatch") ## fixed effect
p1<-ggplot(pred, aes(x = x, y = predicted)) + 
  geom_line(color = "blue") +
  geom_ribbon(aes(ymin = conf.low, ymax = conf.high), alpha = 0.2) +
  labs(x = "log10(Annual Total Catch)", y = "Capture Duration (days)") +
  theme_bw(base_size = 20) 
p1
png("Window_By_TotalCatch_GLMM_FixedEffect_15May2026.png",
    width = 2000, height = 2000,units="px",res=300)
p1
dev.off()

## overall effect - FIGURE 4
# or multi-stop gradient:

df <- df %>%mutate(predicted = predict(m1.2))
df_labels <- df %>% group_by(fSpecies) %>% slice_max(logCatch)

p2<-ggplot(df, aes(x = logCatch, y = Window, color = fSpecies)) +
  theme_bw(base_size = 20) + 
  geom_point(alpha = 5,size=2) +
  geom_line(aes(y = predicted, group = fSpecies), linewidth = 1.5) +
  labs(y= "Capture Duration (days)", x = "log10(Annual Total Catch)",color=NULL)+
  #scale_color_manual(values = gray.colors(16, start = 0, end = 0.8))
 # scale_color_manual(values=my_colors)
  scale_color_viridis_d(option = "turbo")+
 #theme(legend.position = "bottom",guides(color = guide_legend(nrow = 3)))+
 ggrepel::geom_text_repel(data = df_labels, aes(y = predicted, label = fSpecies),
                         nudge_x = 0.2,  hjust = 0, size = 6) +
 guides(color = "none") 
p2
png("Window_By_TotalCatch_GLMM_MainPlot_15May2026.png",
    width = 3500, height = 3000,units="px",res=300)
p2
dev.off()

# random effects - SUPPLEMENTAL FIGURE S3
ranef_data <- ranef(m1.2, condVar = TRUE)
p3<-dotplot(ranef_data, scales = list(x = list(relation = "free")))
p3
png("Window_By_TotalCatch_GLMM_RandomSlopeIntercept_03July2025.png",
    width = 2000, height = 2000,units="px",res=300)
p3
dev.off()



