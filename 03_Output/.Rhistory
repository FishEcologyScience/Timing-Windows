library(multcomp)
m1<-lmer(Window ~ TotalCatch * Species + (1 | Year),data=df.c, REML=T) ### best format since our data are crossed (i.e., there is a transect value for both day and night)
str(df.c)
df.c$fSpecies<-as.factor(df.c$Species)
df.c$nTotalCatch<-as.numeric(df.c$TotalCatch)
df.c$fYear<-as.factor(df.c$Year)
m1<-lmer(Window ~ nTotalCatch * fSpecies + (1 | fYear),data=df.c, REML=T) ### best format since our data are crossed (i.e., there is a transect value for both day and night)
summary(m1)
m1<-lmer(Window ~ nTotalCatch + fSpecies + (1 | fYear),data=df.c, REML=T) ### best format since our data are crossed (i.e., there is a transect value for both day and night)
summary(m1)
m1<-lmer(Window ~ nTotalCatch + (1 | fSpecies) + (1 | fYear),data=df.c, REML=T) ### best format since our data are crossed (i.e., there is a transect value for both day and night)
summary(m1)
summary(df.c)
str(df.c)
m1<-lmer(Window ~ logCatch + (1 | fSpecies) + (1 | fYear),data=df.c, REML=T) ### best format since our data are crossed (i.e., there is a transect value for both day and night)
summary(m1)
m2<-lmer(Window ~ logCatch * fSpecies + (1 | fYear),data=df.c, REML=T) ### best format since our data are crossed (i.e., there is a transect value for both day and night)
summary(m2)
marginal = lsmeans::lsmeans(m2,~fSpecies)
letter.comp<-cld(marginal,
alpha   = 0.05,
Letters = letters,     ### Use lower-case letters for .group
adjust  = "tukey",
sort=F)
lt.c<-letter.comp[ , c("fSpecies")]
lt.c
lt.c.merge<-merge(lt.c,marginal,by=c("fSpecies"))
head(lt.c)
head(marginal)
marginal
