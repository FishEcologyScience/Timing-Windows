p <- p + annotate("rect", xmin = 17.5, xmax = 28.5, ymin = -Inf, ymax = Inf, alpha = 0.2, fill = "#D55E00")
p
png("Fishway_Largemouth Bass_by_Year_17Sept2025.png",
width = 2800, height = 2400,units="px",res=300)
