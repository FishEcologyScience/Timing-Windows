lm.pike<-lm(Window~logCatch,data=subset(df.c,Species=="Northern Pike"))
abline(lm.pike)
summary(lm.pike)
plot(Window~logCatch,data=subset(df.c,Species=="Yellow Perch"))
lm.perch<-lm(Window~logCatch,data=subset(df.c,Species=="Yellow Perch"))
abline(lm.perch)
summary(lm.perch)
# dayly means - problematic b/c of unequal sampling among years
df.d.plot.mean<-aggregate(Prop.Year~Species+Day,data=df.d.plot,FUN=mean)
df.d.plot.mean$fSpecies<-as.factor(df.d.plot.mean$Species)
df.d.plot.mean.2<-merge(df.d.plot.mean,sum.species,by="Species",all=T)
df.d.plot.mean.2$fSpecies2 <- factor(df.d.plot.mean.2$fSpecies, levels = c("Rainbow Trout", "Northern Pike", "White Sucker", "Yellow Perch", "Rudd", "Brown Bullhead",
"Black Crappie","Bowfin",'White Perch',"Goldfish","Largemouth Bass","Black Bullhead",
"Bigmouth Buffalo","White Bass","Common Carp","Common Carp x Goldfish","Channel Catfish",
"Freshwater Drum","Gizzard Shad"))
# Calculate the mean and standard error
l.model <- lm(Day.Sum ~ 1, subset(df.b,Species=="Common Carp"))
plot(Day.Sum ~ Year, subset(df.b,Species=="Bowfin"))
# Calculate the mean and standard error
l.model <- lm(Day.Sum ~ 1, subset(df.b,Species=="Bowfin"))
plot(Day.Sum ~ Year, subset(df.b,Species=="Bowfin"))
# Calculate the confidence interval
confint(l.model, level=0.95)
summary(l.model)
abline(l.model)
