df.sub <- subset(df.wk.plot,Prop.Year>=0.05)
df.d<-data.frame(time.wk.window(df.sub))
df.d$Window<-as.numeric(df.d$Tracking.Window + 1) ## need to add 1 otherwise doesn't count the first day.
