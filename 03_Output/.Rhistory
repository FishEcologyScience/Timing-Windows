## cumulative sum by species x year
df_cumsum <- df.wk.summary %>%
group_by(fSpecies, fYear) %>%
arrange(fSpecies, fYear,Week) %>%  # optional: make sure data is ordered
mutate(cum_sum = cumsum(Prop.Year))
