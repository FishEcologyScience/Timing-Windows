library(plyr)
library(lubridate)
library(reshape)
library(data.table)
library(dplyr)
library(ggplot2)
library(lme4)
library(car)
library(lmerTest)
library(performance)
library(lsmeans)
library(multcomp)
library(ggeffects)
## load data
df <- readRDS("~/github/Timing-Windows/02_Data/TW_Fishway_Window_Catch_19June2025.rds")
head(df) ## base dataset
m1<-lmer(Window ~ logCatch + (1 | fSpecies) ,data=df.c, REML=T) # only random intercept by species
summary(m1)
m1<-lmer(Window ~ logCatch + (1 | fSpecies) ,data=df, REML=T) # only random intercept by species
summary(m1)
m1.2 <- lmer(Window ~ logCatch + (logCatch | fSpecies) ,data=df, REML=T) ## random slope and intercept by species
summary(m1.2)
m2<-lmer(Window ~ logCatch + (logCatch | fSpecies) fSpecies + (1 | fYear),data=df, REML=T) #
m2<-lmer(Window ~ logCatch + (logCatch | fSpecies) + (1 | fYear),data=df, REML=T) #
summary(m2)
pred <- ggpredict(m1.2, terms = "logCatch")
ggplot(pred, aes(x = x, y = predicted)) +
geom_line(color = "blue") +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high), alpha = 0.2) +
labs(x = "log(TotalCatch)", y = "Predicted Time Window") +
theme_minimal()
ggplot(pred, aes(x = x, y = predicted)) +
geom_line(color = "blue") +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high), alpha = 0.2) +
labs(x = "log(TotalCatch)", y = "Predicted Time Window") +
theme_bw(base_size = 20)
## overall effect
df <- df %>%mutate(predicted = predict(m1.2))
ggplot(df, aes(x = logCatch, y = Window, color = fSpecies)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE, aes(group = fSpecies))
ggplot(df, aes(x = logCatch, y = Window, color = fSpecies)) +
theme_bw(base_size = 20) +
geom_point(alpha = 0.6) +
geom_line(aes(y = predicted, group = fSpecies), size = 1) +
labs(y= "Capture Window (weeks)", x = "log10(Annual Total Catch)",color="Species")
df$pred.global <- ggpredict(m1.2, terms = "logCatch") ## fixed effect
pred
pred <- ggpredict(m1.2, terms = "logCatch") ## fixed effect
ggplot(pred, aes(x = x, y = predicted)) +
geom_line(color = "blue") +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high), alpha = 0.2) +
labs(x = "log10(Annual Total Catch)", y = "Predicted Capture Window (weeks)") +
theme_bw(base_size = 20)
## overall effect
df <- df %>%mutate(predicted = predict(m1.2))
ggplot(df, aes(x = logCatch, y = Window, color = fSpecies)) +
theme_bw(base_size = 20) +
geom_point(alpha = 0.6) +
geom_line(aes(y = predicted, group = fSpecies), size = 1) +
labs(y= "Capture Window (weeks)", x = "log10(Annual Total Catch)",color="Species")
# random effects
ranef_data <- ranef(m1.2, condVar = TRUE)
dotplot(ranef_data, scales = list(x = list(relation = "free")))
library(sjPlot)
# Fixed effects
plot_model(m1, type = "eff", terms = "logCatch",)
# Random effects
plot_model(m1, type = "re",show.values = TRUE,value.offset = 0.3)
## random slopes
m1.2 <- lmer(Window ~ logCatch + (logCatch | fSpecies) ,data=df.c, REML=T)
library(sjPlot)
# Fixed effects
plot_model(m1, type = "eff", terms = "logCatch",)
# Random effects
plot_model(m1, type = "re",show.values = TRUE,value.offset = 0.3)
## random slopes
m1.2 <- lmer(Window ~ logCatch + (logCatch | fSpecies) ,data=df.c, REML=T)
plot(m1.2)
summary(m1.2) # p=0.0009 ## most appropriate model?
rm(list = ls())
