## Load Packages ##
###################
library(plyr)
library(lubridate)
library(reshape)
library(data.table)
library(lattice)
library(dplyr)
library(ggplot2)
library(tidyr)
library(reshape2)
df.wk.plot <- readRDS("02_Data/TW_Fishway_WeeklyMeans_by_Species_03July2025.rds")
setwd("~/github/Timing-Windows/03_Output/")
## cumulative sum by species x year
df.cumul.prop <- df.wk.plot %>%
group_by(fSpecies, fYear) %>%
arrange(fSpecies, fYear,Week) %>%  # optional: make sure data is ordered
mutate(cumul.prop = cumsum(Prop.Year))
df.cumul.catch <- df.wk.plot %>%
group_by(fSpecies, fYear) %>%
arrange(fSpecies, fYear,Week) %>%  # optional: make sure data is ordered
mutate(cumul.catch = cumsum(Week.Sum))
df.cumul.prop$cumul.catch<-df.cumul.catch$cumul.catch
head(df.cumul.prop)
###########
## testing relationship btw total catch and exclusion
test<-subset(df.cumul.prop,Species=="Bowfin")
head(test)
View(test)
result <- test %>%
group_by(Year) %>%
slice_min(abs(cumul.prop - 0.5), n = 1, with_ties = FALSE) %>%
ungroup()
result
plot(Week~Year.Sum,data=results)
plot(Week~Year.Sum,data=result)
abline(Week~Year.Sum,data=result)
abline(lm(Week~Year.Sum,data=result))
head(test)
result <- df.cumul.prop %>%
group_by(Species,Year) %>%
slice_min(abs(cumul.prop - 0.5), n = 1, with_ties = FALSE) %>%
ungroup()
head(result)
plot(Week~Year.Sum,data=result)
abline(lm(Week~Year.Sum,data=result))
